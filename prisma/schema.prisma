datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  role       Role     @default(PARENT)
  phone      String?
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    Student?
  parent     Parent?
}

model SchoolClass {
  id        String   @id @default(uuid())
  name      String
  section   String
  students  Student[]
  subjects  Subject[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  class     SchoolClass @relation(fields: [classId], references: [id])
  classId   String
}

model Parent {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  children  Student[]
}

model Student {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String    @unique
  fullName     String
  dob          DateTime
  bloodGroup   String?
  height       Float?
  weight       Float?
  address      String?
  transport    Transport?
  transportId  String?
  class        SchoolClass @relation(fields: [classId], references: [id])
  classId      String
  parent       Parent?    @relation(fields: [parentId], references: [id])
  parentId     String?
  photo        String?
  attendances  Attendance[]
  homeworks    HomeworkSubmission[]
}

model Transport {
  id          String  @id @default(uuid())
  route       String
  driver      String
  vehicleNo   String?
  pickupPoint String?
  pickupTime  String?
}

model Attendance {
  id         String           @id @default(uuid())
  date       DateTime
  status     AttendanceStatus
  student    Student          @relation(fields: [studentId], references: [id])
  studentId  String
  markedBy   String?
}

model Homework {
  id          String   @id @default(uuid())
  title       String
  description String?
  attachments String? // JSON string array of URLs
  dueDate     DateTime
  class       SchoolClass @relation(fields: [classId], references: [id])
  classId     String
  assignedBy  String
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id         String   @id @default(uuid())
  homework   Homework @relation(fields: [homeworkId], references: [id])
  homeworkId String
  student    Student  @relation(fields: [studentId], references: [id])
  studentId  String
  fileUrl    String?
  submittedAt DateTime @default(now())
  remarks    String?
}

model Payment {
  id         String   @id @default(uuid())
  amount     Float
  status     String
  method     String
  parent     Parent?  @relation(fields: [parentId], references: [id])
  parentId   String?
  student    Student? @relation(fields: [studentId], references: [id])
  studentId  String?
  razorpayId String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String
  roles     Role[]
  readBy    String[] // userIds
  createdAt DateTime @default(now())
}

model Album {
  id        String   @id @default(uuid())
  title     String
  photos    String[]
  eventDate DateTime?
}

model Timetable {
  id        String   @id @default(uuid())
  class     SchoolClass @relation(fields: [classId], references: [id])
  classId   String
  day       Int
  subject   Subject   @relation(fields: [subjectId], references: [id])
  subjectId String
  startTime String
  endTime   String
  teacherId String?
}

model Setting {
  id       String  @id @default(uuid())
  key      String  @unique
  value    String
  updatedAt DateTime @updatedAt
}
